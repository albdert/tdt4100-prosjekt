<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.controllers.GameOverController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: rgba(0, 0, 0, 0.75);">
    <!-- Centered game over panel -->
    <VBox alignment="CENTER"
          spacing="0"
          style="-fx-background-color: #0d0d0f;
                 -fx-background-radius: 12;
                 -fx-border-color: #1a1a2e;
                 -fx-border-width: 2;
                 -fx-border-radius: 12;"
          prefWidth="300" maxWidth="300">
        <!-- Header -->
        <VBox alignment="CENTER"
              spacing="6"
              style="-fx-padding: 32 32 28 32;
                     -fx-border-color: transparent transparent #1a1a2e transparent;
                     -fx-border-width: 0 0 2 0;">
            <Label fx:id="gameOverSymbol" text="■"
                   style="-fx-text-fill: #f87171;
                          -fx-font-size: 28;
                          -fx-font-weight: bold;"/>
            <Label fx:id="gameOverTitle" text="GAME OVER"
                   style="-fx-text-fill: #ffffff;
                          -fx-font-size: 26;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 6;"/>
            <Label fx:id="gameOverText" text="BETTER LUCK NEXT TIME"
                   style="-fx-text-fill: #333344;
                          -fx-font-size: 9;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 3;"/>
        </VBox>
        <!-- Score section -->
        <VBox alignment="CENTER"
              spacing="0"
              style="-fx-padding: 24 32 8 32;
                     -fx-border-color: transparent transparent #1a1a2e transparent;
                     -fx-border-width: 0 0 2 0;">
            <Label text="FINAL SCORE"
                   style="-fx-text-fill: #333344;
                          -fx-font-size: 9;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 3;
                          -fx-padding: 0 0 10 0;"/>
            <Label fx:id="scoreLabel"
                   text="00000"
                   style="-fx-text-fill: #f87171;
                          -fx-font-size: 42;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 2;"/>
            <!-- Stats row -->
            <HBox alignment="CENTER"
                  spacing="0"
                  style="-fx-padding: 16 0 24 0;"
                  prefWidth="Infinity">
                <!-- Level -->
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="LEVEL"
                           style="-fx-text-fill: #333344;
                                  -fx-font-size: 9;
                                  -fx-letter-spacing: 2;
                                  -fx-padding: 0 0 4 0;"/>
                    <Label fx:id="levelLabel"
                           text="1"
                           style="-fx-text-fill: #888899;
                                  -fx-font-size: 14;
                                  -fx-font-weight: bold;"/>
                </VBox>
                <Separator orientation="VERTICAL"
                           style="-fx-background-color: #1a1a2e;
                                  -fx-padding: 0;"/>
                <!-- High score -->
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="HIGH SCORE"
                           style="-fx-text-fill: #333344;
                                  -fx-font-size: 9;
                                  -fx-letter-spacing: 2;
                                  -fx-padding: 0 0 4 0;"/>
                    <Label fx:id="highScoreLabel"
                           text="00000"
                           style="-fx-text-fill: #4ade80;
                                  -fx-font-size: 14;
                                  -fx-font-weight: bold;"/>
                </VBox>
                <Separator orientation="VERTICAL"
                           style="-fx-background-color: #1a1a2e;"/>
                <!-- Time -->
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="TIME"
                           style="-fx-text-fill: #333344;
                                  -fx-font-size: 9;
                                  -fx-letter-spacing: 2;
                                  -fx-padding: 0 0 4 0;"/>
                    <Label fx:id="timeLabel"
                           text="0:00"
                           style="-fx-text-fill: #888899;
                                  -fx-font-size: 14;
                                  -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
        <!-- Buttons -->
        <VBox alignment="CENTER"
              spacing="10"
              style="-fx-padding: 24 32 28 32;">
            <Button fx:id="savescore"
                    text="▲   SAVE SCORE"
                    onAction="#handleButtonClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #f87171;
                           -fx-text-fill: #1a0a0a;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-letter-spacing: 3;
                           -fx-padding: 14 24;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;"/>
            <Button fx:id="restart"
                    text="↺   RESTART"
                    onAction="#handleButtonClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1a1a2e;
                           -fx-text-fill: #888899;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-letter-spacing: 3;
                           -fx-padding: 14 24;
                           -fx-background-radius: 6;
                           -fx-border-color: #2a2a4a;
                           -fx-border-width: 1;
                           -fx-border-radius: 6;
                           -fx-cursor: hand;"/>
            <Button fx:id="mainmenu"
                    text="⌂   MAIN MENU"
                    onAction="#handleButtonClick"
                    maxWidth="Infinity"
                    style="-fx-background-color: #0d0d0f;
                           -fx-text-fill: #555566;
                           -fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-letter-spacing: 3;
                           -fx-padding: 14 24;
                           -fx-background-radius: 6;
                           -fx-border-color: #1a1a2e;
                           -fx-border-width: 1;
                           -fx-border-radius: 6;
                           -fx-cursor: hand;"/>
        </VBox>
    </VBox>
</VBox>