<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.Group?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller = "block.controllers.BlockController"
           fx:id="root"
           prefWidth="720" prefHeight="720"
           style="-fx-background-color: #0d0d0f;">
    <BorderPane prefWidth="720" prefHeight="720">
        <!-- TOP: Header with title and score -->
        <top>
            <VBox alignment="CENTER" spacing="4" style="-fx-padding: 24 32 16 32; -fx-border-color: transparent transparent #1a1a2e transparent; -fx-border-width: 0 0 2 0;">
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="16">
                    <Label text="BLOCKS" style="-fx-text-fill: #ffffff; -fx-font-size: 22; -fx-font-weight: bold; -fx-letter-spacing: 6;"/>
                    <!-- Snake game switcher button -->
                </HBox>
                <HBox alignment="CENTER" spacing="48" style="-fx-padding: 8 0 0 0;">
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="SCORE" style="-fx-text-fill: #333344; -fx-font-size: 9; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>
                        <Label fx:id="scoreLabel" text="0" style="-fx-text-fill: #4ade80; -fx-font-size: 28; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="HIGH SCORE" style="-fx-text-fill: #333344; -fx-font-size: 9; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>
                        <Label fx:id="highScoreLabel" text="0" style="-fx-text-fill: #888899; -fx-font-size: 28; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="LEVEL" style="-fx-text-fill: #333344; -fx-font-size: 9; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>
                        <Label fx:id="levelLabel" text="1" style="-fx-text-fill: #60a5fa; -fx-font-size: 28; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>
        </top>
        <!-- CENTER: Canvas with glow border -->
        <center>
            <StackPane alignment="CENTER">
                <Group>
                    <!-- Glow border -->
                    <Region prefWidth="454" prefHeight="404" style="-fx-background-color: #4aaade; -fx-effect: dropshadow(gaussian, #4aaade80, 18, 0.3, 0, 0);"/>
                    <!-- Canvas inset by 2px -->
                    <Canvas fx:id="canvas" layoutX="2" layoutY="2" width="450" height="400"/>
                </Group>
            </StackPane>
        </center>
        <!-- BOTTOM: Controls hint + Start button -->
        <bottom>
            <HBox alignment="CENTER" spacing="24" style="-fx-padding: 12 32 20 32; -fx-border-color: #1a1a2e transparent transparent transparent; -fx-border-width: 2 0 0 0;">
                <HBox spacing="6" alignment="CENTER">
                    <Label text="↑ ↓ ← →" style="-fx-text-fill: #2a2a3e; -fx-font-size: 12; -fx-background-color: #1a1a2e; -fx-background-radius: 4; -fx-padding: 3 8;"/>
                    <Label text="MOVE" style="-fx-text-fill: #333344; -fx-font-size: 9; -fx-font-weight: bold; -fx-letter-spacing: 1;"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER">
                    <Label text="ESC" style="-fx-text-fill: #2a2a3e; -fx-font-size: 12; -fx-background-color: #1a1a2e; -fx-background-radius: 4; -fx-padding: 3 8;"/>
                    <Label text="PAUSE" style="-fx-text-fill: #333344; -fx-font-size: 9; -fx-font-weight: bold; -fx-letter-spacing: 1;"/>
                </HBox>
                <Button text="START GAME" onAction="#startGame" style="-fx-background-color: #4ade80; -fx-text-fill: #0d0d0f; -fx-font-size: 11; -fx-font-weight: bold; -fx-letter-spacing: 2; -fx-padding: 7 20; -fx-background-radius: 4; -fx-cursor: hand;"/>
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>