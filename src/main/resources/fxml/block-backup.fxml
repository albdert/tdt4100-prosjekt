<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller = "block.controllers.BlockController"
           fx:id="root"
           prefWidth="720" prefHeight="720"
           style="-fx-background-color: #0d0d0f;">

    <VBox spacing="10">
        <Canvas fx:id="canvas" width="450" height = "400"/>
        <Label fx:id = "scoreLabel" text ="Score:" />
        <Button text = "Start Spill!" onAction ="#startGame" />
    </VBox>
</StackPane>