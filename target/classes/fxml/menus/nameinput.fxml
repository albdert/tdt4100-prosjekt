<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.controllers.NameInputController"
            style="-fx-background-color: #0d0d0f;"
            prefWidth="720" prefHeight="720">

    <!-- TOP: Title bar -->
    <top>
        <VBox alignment="CENTER" style="-fx-padding: 32 0 16 0;">
            <Label text="PLAYER SETUP"
                   style="-fx-text-fill: #ffffff;
                          -fx-font-size: 36;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 8;"/>
            <Label text="ENTER YOUR DETAILS"
                   style="-fx-text-fill: #555566;
                          -fx-font-size: 11;
                          -fx-letter-spacing: 4;"/>
        </VBox>
    </top>

    <!-- CENTER: Name input form -->
    <center>
        <VBox alignment="CENTER"
              spacing="16"
              style="-fx-padding: 40 120 40 120;">

            <!-- Prompt label -->
            <Label text="ENTER YOUR NAME"
                   style="-fx-text-fill: #888899;
                          -fx-font-size: 13;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 3;"/>

            <!-- Description text -->
            <Label text="Your name will be displayed on the highscore board."
                   wrapText="true"
                   style="-fx-text-fill: #444455;
                          -fx-font-size: 11;
                          -fx-letter-spacing: 1;"/>

            <!-- Input field -->
            <TextField fx:id="nameInput"
                       promptText="Type your name here..."
                       style="-fx-background-color: #1a1a2e;
                              -fx-text-fill: #ffffff;
                              -fx-prompt-text-fill: #444455;
                              -fx-font-size: 14;
                              -fx-padding: 14 16;
                              -fx-background-radius: 6;
                              -fx-border-color: #2a2a4a;
                              -fx-border-width: 1;
                              -fx-border-radius: 6;"
                       maxWidth="480"/>

            <!-- Error message label (hidden by default) -->
            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #ef4444;
                          -fx-font-size: 11;
                          -fx-font-weight: bold;
                          -fx-letter-spacing: 1;"
                   maxWidth="480"/>

            <!-- Save button -->
            <Button fx:id="saveName"
                    text="✔  SAVE NAME"
                    onAction="#handleSaveName"
                    style="-fx-background-color: #1a2e1a;
                           -fx-text-fill: #4ade80;
                           -fx-font-size: 12;
                           -fx-font-weight: bold;
                           -fx-letter-spacing: 2;
                           -fx-padding: 12 32;
                           -fx-background-radius: 6;
                           -fx-border-color: #2a4a2a;
                           -fx-border-width: 1;
                           -fx-border-radius: 6;
                           -fx-cursor: hand;"/>

        </VBox>
    </center>

    <!-- BOTTOM: Back to main menu -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="16"
              style="-fx-padding: 20 40 32 40;">
            <Button fx:id="menu"
                    text="⌂  MAIN MENU"
                    onAction="#handleButtonClick"
                    style="-fx-background-color: #1a1a2e;
                           -fx-text-fill: #888899;
                           -fx-font-size: 11;
                           -fx-font-weight: bold;
                           -fx-letter-spacing: 2;
                           -fx-padding: 10 24;
                           -fx-background-radius: 6;
                           -fx-border-color: #2a2a4a;
                           -fx-border-width: 1;
                           -fx-border-radius: 6;
                           -fx-cursor: hand;"/>
            <Button fx:id="quit"
                    text="✕  QUIT"
                    onAction="#handleButtonClick"
                    style="-fx-background-color: #2a1a1a;
                           -fx-text-fill: #ef4444;
                           -fx-font-size: 11;
                           -fx-font-weight: bold;
                           -fx-letter-spacing: 2;
                           -fx-padding: 10 24;
                           -fx-background-radius: 6;
                           -fx-border-color: #4a2a2a;
                           -fx-border-width: 1;
                           -fx-border-radius: 6;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
